<?xml version="1.0" encoding="utf-8"?>
<!-- Snapdoc mark: rounded document square + diagonal scan beam.
     Per design system §1.3: 22% radius, 8% stroke, 28° beam, 4% gap. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded square: 60dp wide in the 72dp safe zone, 13.2 radius (22%), 4.8 stroke (8%). -->
    <path
        android:pathData="M37.2,24 L70.8,24 A13.2,13.2 0 0 1 84,37.2 L84,70.8 A13.2,13.2 0 0 1 70.8,84 L37.2,84 A13.2,13.2 0 0 1 24,70.8 L24,37.2 A13.2,13.2 0 0 1 37.2,24 Z"
        android:strokeColor="#111111"
        android:strokeWidth="4.8"
        android:fillColor="#00000000" />

    <!-- Diagonal scan beam at ~28°, stroke 4.8.
         Goes from upper-right (just outside square) to lower-left. -->
    <path
        android:pathData="M90,38 L18,76"
        android:strokeColor="#111111"
        android:strokeWidth="4.8"
        android:strokeLineCap="round" />

</vector>
